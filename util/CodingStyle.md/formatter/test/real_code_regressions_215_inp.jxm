function computeAlign(halign)
      if ${halign} &== 'l' ; halign := 2
    elif ${halign} &== 'r' ; halign := 4
    elif ${halign} &== 'c' ; halign := 0
    else                   ; halign := ''
    endif
    return halign
endfunction
